// Deathmatch and Team Deathmatch tuning (deathmatch.rs reads this at start-up). Everything here is ours or
// derived by hand from the original multiplayer rules (DeusExMPGame / DeathMatchGame / TeamDMGame, DeusExWeapon mp*
// properties); map pickup lists were made from the DXMP maps' placed actors by tools (scratchpad balance.py, see
// CLAUDE.md 3zz63) and are only actor names.
(
    // Damage a hit does to a player, in health points of a 100-point region (deathmatch players have the
    // original MP's three regions: head, body = torso and arms, legs; head or body at 0 is death). Shotguns: per
    // pellet. Weapons not listed, and blasts / fire / gas / poison, use `kinds` x the weapon's own damage.
    // The original MP numbers were mpHitDamage x2 for a head shot (pistol 20 / 40): too soft for a "real" feel, so
    // a pistol or rifle head shot kills or nearly kills, a few body shots kill, the rifle body shot nearly kills.
    weapons: {
        "WeaponPistol":          (body: 34, head: 100, legs: 25),
        "WeaponStealthPistol":   (body: 20, head: 75,  legs: 15),
        "WeaponAssaultGun":      (body: 15, head: 60,  legs: 11),
        "WeaponAssaultShotgun":  (body: 9,  head: 22,  legs: 7),
        "WeaponSawedOffShotgun": (body: 12, head: 28,  legs: 9),
        "WeaponRifle":           (body: 75, head: 200, legs: 55),
        "WeaponMiniCrossbow":    (body: 30, head: 90,  legs: 22),
        "WeaponShuriken":        (body: 30, head: 80,  legs: 22),
        "WeaponCombatKnife":     (body: 30, head: 60,  legs: 22),
        "WeaponNanoSword":       (body: 60, head: 120, legs: 45),
        "WeaponSword":           (body: 35, head: 75,  legs: 25),
        "WeaponCrowbar":         (body: 25, head: 55,  legs: 18),
        "WeaponBaton":           (body: 15, head: 35,  legs: 10),
        "WeaponProd":            (body: 20, head: 40,  legs: 15),
    },
    // Damage types a table entry stands for (the weapon's own trace / blow); anything else is scaled by `kinds`.
    traced: ["Shot", "Sabot", "KnockedOut", "Stunned"],
    // Multipliers on the game's own damage for everything else (SP blast damage is lethal near: x0.6 keeps a
    // rocket or LAM deadly within a few metres, a grenade's edge survivable).
    kinds: { "Exploded": 0.6, "Burned": 1.0, "Flamed": 1.0, "Shocked": 0.8, "Poison": 1.0, "PoisonGas": 1.0,
             "TearGas": 1.0, "Radiation": 1.0, "EMP": 1.0, "Fell": 1.0, "Drowned": 1.0 },
    // Team Deathmatch friendly fire (TeamDMGame fFriendlyFireMult).
    friendly_fire_mult: 0.5,
    // Pickup tiers and their respawn times (seconds after somebody takes one).
    respawn: { "power": 120, "heavy": 90, "common": 30, "grenade": 45, "ammo": 20, "item": 20, "tool": 30 },
    tiers: {
        "WeaponGEPGun": "power",
        "WeaponLAW": "heavy", "WeaponPlasmaRifle": "heavy", "WeaponFlamethrower": "heavy", "WeaponRifle": "heavy",
        "WeaponNanoSword": "heavy",
        "WeaponPistol": "common", "WeaponStealthPistol": "common", "WeaponAssaultGun": "common",
        "WeaponAssaultShotgun": "common", "WeaponSawedOffShotgun": "common", "WeaponMiniCrossbow": "common",
        "WeaponCombatKnife": "common", "WeaponShuriken": "common", "WeaponSword": "common", "WeaponCrowbar": "common",
        "WeaponBaton": "common", "WeaponProd": "common", "WeaponPepperGun": "common", "WeaponHideAGun": "common",
        "WeaponLAM": "grenade", "WeaponEMPGrenade": "grenade", "WeaponGasGrenade": "grenade",
        "WeaponNanoVirusGrenade": "grenade",
        "Ammo20mm": "ammo", "AmmoRocketWP": "ammo", "AmmoRocket": "ammo", "Ammo10mm": "ammo", "Ammo762mm": "ammo",
        "AmmoShell": "ammo", "AmmoSabot": "ammo", "Ammo3006": "ammo", "AmmoPlasma": "ammo", "AmmoNapalm": "ammo",
        "AmmoDart": "ammo", "AmmoDartPoison": "ammo", "AmmoDartFlare": "ammo", "AmmoShuriken": "ammo",
        "MedKit": "item", "BioelectricCell": "item", "BallisticArmor": "item", "HazMatSuit": "item",
        "Multitool": "tool", "Lockpick": "tool",
    },
    // GiveInitialInventory in multiplayer: a pistol with 50 rounds, a medkit, a lockpick and a multitool.
    start_kit: [("WeaponPistol", 50), ("MedKit", 1), ("Lockpick", 1), ("Multitool", 1)],
    // DeusExMPGame: InitialAugs / AugsPerKill (Deathmatch 2 / 2, Team Deathmatch 0 / 0), granted at full level in
    // DeusExPlayer.AugPrefs order; skills at MPSkillStartLevel (Trained).
    dm_augs: (2, 2),
    team_augs: (0, 0),
    aug_prefs: ["AugVision", "AugHealing", "AugSpeed", "AugDefense", "AugBallistic", "AugShield", "AugEMP", "AugStealth",
                "AugAqualung"],
    skill_level: 1,
    // Kills with a weapon class needed for each of its Augmentique skins in turn.
    skin_unlocks: [10, 25, 50, 100, 200, 350, 500],
    // DeusExMPGame.NewMapDelay: seconds the results show before the next map.
    new_map_delay: 16,
    // Modern: the living level (living.rs). Heat per player: unsilenced shots staff hear, a camera seeing a drawn
    // weapon (per second), staff seeing a restricted area entered or a lockpick / multitool at work (per second);
    // hurting staff is wanted at once. Wanted at 100, calm again below 40, drains after 12 s out of sight.
    // A hacked security computer / camera / turret is the hacker's for hacked_secs. Guards walk the map's own
    // patrol routes (people first, then bots, up to max_guards; a map's `staff` can change that).
    living: (
        heat: (suspicious: 30, wanted: 100, calm_below: 40, max: 160, hold_secs: 12, decay: 9, shot_heard: 34,
               weapon_seen_rate: 15, restricted_rate: 70, tampering_rate: 60),
        hacked_secs: 120,
        ping_secs: 8,
        owned_ping_every: 2,
        guard: "MJ12Troop",
        bot: "SecurityBot3",
        max_guards: 6,
        dark_reach: 320,
        dark: 0.06,
    ),
    // Modern: the operative profile (dmchar.rs). Credits per thing done in a match (shown after it), kills with a
    // weapon for each mastery level, loadouts kept.
    profile: (
        per_kill: 10, per_takedown: 15, per_assist: 5, per_hack: 8, per_heal: 5, per_objective: 20,
        per_match: 25, per_win: 75,
        mastery: [10, 25, 50, 100, 200, 350, 500],
        max_loadouts: 5,
    ),
    // Modern: loadouts on a points budget (imsim_core::loadout). Every player has the same `budget` unless the host
    // picks Full (no cap). Skills start Trained; levels above it cost skill_steps in turn (Advanced 8, Master +10).
    // `unlock`: credits to unlock an entry (anything not listed is open); `mod_mastery`: the weapon mastery level a
    // mod needs on that weapon (dmchar mastery: kills with it). `ammo`: rounds given with a weapon.
    loadouts: (
        prices: (
            budget: 100,
            max_weapons: 3,
            max_augs: 3,
            max_mods_per_weapon: 3,
            skill_steps: [8, 10],
            weapons: {
                "WeaponPistol": 0, "WeaponStealthPistol": 6, "WeaponCombatKnife": 2, "WeaponCrowbar": 2,
                "WeaponBaton": 2, "WeaponSword": 6, "WeaponProd": 8, "WeaponPepperGun": 4, "WeaponShuriken": 6,
                "WeaponMiniCrossbow": 8, "WeaponSawedOffShotgun": 12, "WeaponAssaultShotgun": 16,
                "WeaponAssaultGun": 16, "WeaponRifle": 22, "WeaponNanoSword": 24, "WeaponFlamethrower": 26,
                "WeaponLAW": 26, "WeaponPlasmaRifle": 30, "WeaponGEPGun": 34,
            },
            items: {
                "MedKit": 4, "BioelectricCell": 5, "Lockpick": 2, "Multitool": 3, "WeaponLAM": 8,
                "WeaponEMPGrenade": 6, "WeaponGasGrenade": 6, "WeaponNanoVirusGrenade": 6, "BallisticArmor": 10,
                "HazMatSuit": 6, "AdaptiveArmor": 14, "TechGoggles": 6,
            },
            item_max: {
                "MedKit": 3, "BioelectricCell": 2, "Lockpick": 2, "Multitool": 2, "WeaponLAM": 2, "WeaponEMPGrenade": 2,
                "WeaponGasGrenade": 2, "WeaponNanoVirusGrenade": 2, "BallisticArmor": 1, "HazMatSuit": 1,
                "AdaptiveArmor": 1, "TechGoggles": 1,
            },
            augs: {
                "AugCloak": 22, "AugRadarTrans": 16, "AugVision": 12, "AugSpeed": 14, "AugStealth": 10,
                "AugBallistic": 16, "AugShield": 12, "AugEMP": 8, "AugHealing": 16, "AugDefense": 14,
                "AugCombat": 10, "AugMuscle": 8, "AugTarget": 12, "AugAqualung": 2, "AugPower": 10,
                "AugEnviro": 8, "AugDrone": 18, "AugHeartLung": 12,
            },
            mods: {
                "WeaponModAccuracy": 4, "WeaponModClip": 4, "WeaponModRange": 3, "WeaponModRecoil": 3,
                "WeaponModReload": 3, "WeaponModScope": 5, "WeaponModSilencer": 6, "WeaponModLaser": 3,
            },
        ),
        unlock: {
            "WeaponGEPGun": 300, "WeaponPlasmaRifle": 250, "WeaponFlamethrower": 200, "WeaponLAW": 200,
            "WeaponNanoSword": 250, "WeaponRifle": 100, "AdaptiveArmor": 150,
            "AugCloak": 200, "AugDrone": 250, "AugRadarTrans": 150, "AugDefense": 150, "AugHeartLung": 100,
        },
        mod_mastery: {
            "WeaponModAccuracy": 1, "WeaponModClip": 1, "WeaponModRange": 2, "WeaponModRecoil": 2,
            "WeaponModReload": 2, "WeaponModLaser": 3, "WeaponModScope": 3, "WeaponModSilencer": 4,
        },
        ammo: {
            "WeaponPistol": 60, "WeaponStealthPistol": 60, "WeaponMiniCrossbow": 12, "WeaponSawedOffShotgun": 24,
            "WeaponAssaultShotgun": 36, "WeaponAssaultGun": 120, "WeaponRifle": 24, "WeaponFlamethrower": 100,
            "WeaponLAW": 1, "WeaponPlasmaRifle": 48, "WeaponGEPGun": 4, "WeaponPepperGun": 100, "WeaponProd": 24,
            "WeaponShuriken": 10,
        },
        // Six class templates to start from (each within the budget). The signature perk comes with the class
        // whatever the loadout holds.
        classes: [
            (id: "infiltrator", name: "Infiltrator", perk: "Quiet Feet",
             text: "Cloak-and-dagger: silenced pistol, lockpicks, sound-masking augmentations. Signature: footsteps make half the noise.",
             build: (class: "infiltrator", weapons: ["WeaponStealthPistol", "WeaponCombatKnife"],
                     items: [("Lockpick", 2), ("MedKit", 1)], skills: [("SkillWeaponPistol", 1), ("SkillLockpicking", 1)],
                     augs: ["AugStealth", "AugVision"], mods: [("WeaponStealthPistol", "WeaponModAccuracy")])),
            (id: "netrunner", name: "Netrunner", perk: "Wireless Hacking",
             text: "Hacker: multitools, the Computer skill, EMP. Signature: hack cameras, turrets and terminals from 12 metres away with a multitool.",
             build: (class: "netrunner", weapons: ["WeaponPistol", "WeaponProd"],
                     items: [("Multitool", 2), ("WeaponEMPGrenade", 2), ("MedKit", 1)], skills: [("SkillComputer", 2), ("SkillTech", 1)],
                     augs: ["AugEMP", "AugRadarTrans"], mods: [])),
            (id: "enforcer", name: "Enforcer", perk: "Melee Bash",
             text: "Heavy: assault gun and shotgun, ballistic protection. Signature: bash with any firearm (F).",
             build: (class: "enforcer", weapons: ["WeaponAssaultGun", "WeaponSawedOffShotgun"],
                     items: [("MedKit", 1)], skills: [("SkillWeaponRifle", 1)],
                     augs: ["AugBallistic", "AugMuscle"], mods: [("WeaponAssaultGun", "WeaponModClip")])),
            (id: "medic", name: "Medic", perk: "Field Surgeon",
             text: "Support: medkits and healing. Signature: two extra medkits, and a medkit on a teammate heals twice as much.",
             build: (class: "medic", weapons: ["WeaponPistol", "WeaponMiniCrossbow"],
                     items: [("MedKit", 3), ("BioelectricCell", 1)], skills: [("SkillMedicine", 2), ("SkillWeaponPistol", 1)],
                     augs: ["AugHealing", "AugShield"], mods: [])),
            (id: "saboteur", name: "Saboteur", perk: "Demolitions",
             text: "Traps and explosives: LAMs, gas and EMP grenades. Signature: one more LAM than the loadout holds.",
             build: (class: "saboteur", weapons: ["WeaponPistol", "WeaponSawedOffShotgun"],
                     items: [("WeaponLAM", 2), ("WeaponGasGrenade", 2), ("MedKit", 1)], skills: [("SkillDemolition", 2)],
                     augs: ["AugEMP", "AugSpeed"], mods: [])),
            (id: "marksman", name: "Marksman", perk: "Spotter",
             text: "Long range: the rifle line, steady aim. Signature: a rival held in your scope for a second is marked for your team.",
             build: (class: "marksman", weapons: ["WeaponMiniCrossbow", "WeaponPistol"],
                     items: [("MedKit", 1)], skills: [("SkillWeaponRifle", 2), ("SkillWeaponPistol", 1)],
                     augs: ["AugTarget", "AugVision"], mods: [("WeaponMiniCrossbow", "WeaponModScope")])),
        ],
    ),
    // The DXMP maps: kept pickups by actor name (everything else of a class in `tiers` is taken out of the map).
    // Per-mode parts (deathmatch.rs MapEntry; each optional, `modes` empty = every mode; keys dm tdm cdm cbasic
    // cadv ctdm, or classic / modern):
    //   spawns: [(name: "ctf_starts", modes: ["ctf"], points: [(at: (0, 0, 0), yaw: 16384, team: Some(0))])],
    //   blockers: [(name: "north_wall", modes: ["uplink"], at: (0, 0, 0), radius: 200, height: 120)],
    //   objectives: [(name: "unatco_flag", kind: "flag", at: (0, 0, 0), radius: 120, team: Some(0))],
    //   loot: [(name: "crates", actors: ["CrateUnbreakableSmall3"], points: [(0, 0, 0)], items: [("MedKit", 2), ("BioelectricCell", 1)], picks: 2)],
    //   codes: [(name: "vault", devices: ["Keypad0"], digits: 4)],
    // Modern cosmetics (cards.rs): earned by the character's record, never bought. `need` what: kills, takedowns,
    // wins, matches, heals, credits (ever earned). The first of each list is the default.
    cosmetics: (
        tag_colors: [
            (id: "white", name: "White", rgb: (230, 230, 230)),
            (id: "cyan", name: "Cyan", rgb: (90, 220, 255)),
            (id: "amber", name: "Amber", rgb: (255, 190, 60), need: Some((what: "kills", n: 10))),
            (id: "green", name: "Medic Green", rgb: (90, 255, 120), need: Some((what: "heals", n: 5))),
            (id: "violet", name: "Violet", rgb: (190, 130, 255), need: Some((what: "matches", n: 5))),
            (id: "teal", name: "Teal", rgb: (60, 230, 190), need: Some((what: "takedowns", n: 10))),
            (id: "red", name: "Crimson", rgb: (255, 80, 80), need: Some((what: "kills", n: 50))),
            (id: "gold", name: "Gold", rgb: (255, 220, 70), need: Some((what: "wins", n: 3))),
            (id: "magenta", name: "Magenta", rgb: (255, 90, 220), need: Some((what: "credits", n: 2000))),
        ],
        cards: [
            (id: "operative", name: "Operative", title: "OPERATIVE", pattern: "plain", emblem: "ring", accent: (80, 120, 170)),
            (id: "nightshift", name: "Night Shift", title: "NIGHT SHIFT", pattern: "stripes", emblem: "eye", accent: (110, 80, 180)),
            (id: "firstblood", name: "First Blood", title: "FIRST BLOOD", pattern: "chevrons", emblem: "triangle", accent: (190, 50, 50), need: Some((what: "kills", n: 1))),
            (id: "ghost", name: "Ghost", title: "GHOST", pattern: "dots", emblem: "crescent", accent: (150, 160, 175), need: Some((what: "takedowns", n: 5))),
            (id: "fieldmedic", name: "Field Medic", title: "FIELD MEDIC", pattern: "hex", emblem: "cross", accent: (50, 170, 90), need: Some((what: "heals", n: 10))),
            (id: "deadeye", name: "Deadeye", title: "DEADEYE", pattern: "grid", emblem: "crosshair", accent: (200, 140, 40), need: Some((what: "kills", n: 50))),
            (id: "wiretap", name: "Wiretap", title: "WIRETAP", pattern: "circuit", emblem: "diamond", accent: (40, 170, 190), need: Some((what: "credits", n: 1000))),
            (id: "silent", name: "Silent Running", title: "SILENT RUNNING", pattern: "waves", emblem: "bolt", accent: (40, 150, 140), need: Some((what: "takedowns", n: 25))),
            (id: "veteran", name: "Veteran", title: "VETERAN", pattern: "rings", emblem: "star", accent: (170, 140, 60), need: Some((what: "matches", n: 25))),
            (id: "ironclad", name: "Ironclad", title: "IRONCLAD", pattern: "plates", emblem: "shield", accent: (150, 100, 60), need: Some((what: "kills", n: 100))),
            (id: "champion", name: "Champion", title: "CHAMPION", pattern: "rays", emblem: "crown", accent: (210, 170, 40), need: Some((what: "wins", n: 5))),
            (id: "orbital", name: "Orbital", title: "ORBITAL", pattern: "rings", emblem: "orbit", accent: (200, 200, 220), need: Some((what: "wins", n: 25))),
        ],
    ),
    // Modern, Phase 3 (mech.rs and the modules it names). Uniforms: how long one passes, longer for the Infiltrator;
    // a rival is unmasked after looking at him from within close_look for close_look_secs; staff see through it when
    // the wearer runs (faster than run_speed), shows a weapon within armed_near of them, or stands in a restricted
    // room. Framing: staff look body_sight for bodies and weapon_sight for dropped weapons; a weapon within
    // plant_radius of a body is blamed for it. Overwatch: dispatch_cooldown between sending guards; a cut takes
    // sabotage_secs with a multitool (or an EMP blast within the counter table's radius). Lockdowns: default
    // secs / cooldown, the hazards' damage per second. Killphrases: kp_cubes datacubes on each map; spoken within
    // kp_reach; the words a phrase is drawn from.
    mechanics: (
        uniform_secs: 150, uniform_secs_infiltrator: 240, close_look: 420, close_look_secs: 1.25,
        run_speed: 230, armed_near: 320, witness_secs: 0.4,
        body_sight: 1200, weapon_sight: 700, plant_radius: 200,
        dispatch_cooldown: 30, sabotage_secs: 3.5,
        lockdown_secs: 30, lockdown_cooldown: 90,
        hazard_dps: { "gas": 7, "steam": 10, "shock": 18, "fire": 9 },
        kp_cubes: 6, kp_reach: 220,
        kp_words: [
            "amber", "anchor", "apex", "arbor", "ash", "atlas", "basalt", "beacon", "birch", "bramble", "cinder",
            "citadel", "cobalt", "comet", "copper", "coral", "crane", "delta", "drift", "ember", "falcon", "fathom",
            "fern", "flint", "frost", "garnet", "glacier", "granite", "harbor", "hazel", "heron", "indigo", "iris",
            "jasper", "juniper", "kestrel", "lantern", "linden", "lumen", "marrow", "meridian", "mica", "nectar",
            "nimbus", "obsidian", "onyx", "orchid", "osprey", "pewter", "pillar", "quarry", "quartz", "raven",
            "ridge", "saffron", "sable", "sorrel", "spire", "tallow", "thistle", "tundra", "umber", "vessel",
            "willow", "zenith",
        ],
    ),
    // Modern: every power has an answer (counters.rs reads these; the game's rules use `value`). power / answer
    // are names the code knows (counters::POWERS / ANSWERS); `rule` says what the answer does.
    counters: [
        (power: "AugCloak", answer: "AugVision", rule: "reveal_range", value: 1200,
         note: "Vision sees a cloaked rival within this range: name tag and red crosshair."),
        (power: "AugCloak", answer: "TechGoggles", rule: "reveal_range", value: 640,
         note: "Thermal goggles show a cloaked rival closer in."),
        (power: "AugCloak", answer: "Noise", rule: "radar", value: 1,
         note: "Cloak hides the body, not the noise: running steps and shots still show on the sound radar."),
        (power: "AugRadarTrans", answer: "Eyes", rule: "seen_by_eyes", value: 1,
         note: "Radar transparency blinds cameras and turrets only: guards and players still see him."),
        (power: "HackedTurret", answer: "EMP", rule: "disable_secs", value: 20,
         note: "An EMP blast shuts a turret down for this long, hacked or not."),
        (power: "HackedTurret", answer: "Hack", rule: "take_back", value: 1,
         note: "Another player can hack it back at a security computer."),
        (power: "Uniform", answer: "CloseLook", rule: "unmask_secs", value: 1.25,
         note: "Looking straight at a disguised rival from close in for this long unmasks him."),
        (power: "Uniform", answer: "AugVision", rule: "unmask", value: 1,
         note: "Vision sees the face under the cap: disguised rivals in sight are unmasked at once."),
        (power: "Uniform", answer: "Behaviour", rule: "staff_suspicion", value: 1,
         note: "Running, a drawn weapon near guards or a restricted room makes staff suspicious, then blows the cover."),
        (power: "Overwatch", answer: "PowerCut", rule: "out_secs", value: 45,
         note: "A multitool on an occupied seat's computer cuts its power for this long and throws the operator out."),
        (power: "Overwatch", answer: "EMP", rule: "cut_radius", value: 320,
         note: "An EMP blast this close to a seat cuts its power too."),
        (power: "Overwatch", answer: "Exposure", rule: "kick_on_hit", value: 1,
         note: "The operator's body stays in the room: any hit throws him out of the seat."),
        (power: "Lockdown", answer: "Multitool", rule: "override_secs", value: 5,
         note: "A multitool on a sealed door opens it after this many seconds."),
        (power: "Lockdown", answer: "HazMatSuit", rule: "hazard_mult", value: 0.25,
         note: "A hazmat suit takes the lockdown's gas, steam and shock down to this."),
        (power: "Framing", answer: "Evidence", rule: "pickup_clears", value: 1,
         note: "Pick the planted weapon up before staff see it and nobody is blamed but the killer."),
        (power: "Framing", answer: "HideBody", rule: "carried_unseen", value: 1,
         note: "A body that is carried or hidden out of staff sight is never found."),
        (power: "Killphrase", answer: "Death", rule: "new_phrase", value: 1,
         note: "Every life gets a new phrase: fragments of the old one are worthless."),
        (power: "Killphrase", answer: "Distance", rule: "reach", value: 220,
         note: "It has to be said to his face: keep rivals who know your words at arm's length."),
        (power: "Downed", answer: "Teammate", rule: "revive", value: 1,
         note: "A teammate's medkit gets a downed player up before he is finished or interrogated."),
        (power: "AugBallistic", answer: "Melee", rule: "bypass", value: 1,
         note: "Ballistic protection stops bullets, not blades and batons."),
    ],
    maps: [
        // DXMP_Area51Bunker: 67 kept, starts 24, value near starts min 14 max 44 mean 32.3; quadrants [14, 39, 37, 38]
        // Ammo20mm 2, AmmoRocketWP 1, BioelectricCell 8, Lockpick 9, MedKit 6, Multitool 10, AssaultGun 2, AssaultShotgun 3, CombatKnife 2, EMPGrenade 2, Flamethrower 1, GEPGun 1, GasGrenade 2, LAM 2, LAW 1, MiniCrossbow 2, NanoSword 1, Pistol 3, PlasmaRifle 1, Rifle 1, SawedOffShotgun 3, Shuriken 2, StealthPistol 2
        (file: "DXMP_Area51Bunker", title: "Area 51 Bunker", keep: [
            "Ammo20mm1", "Ammo20mm3", "AmmoRocketWP3", "BioelectricCell0", "BioelectricCell1", "BioelectricCell2",
            "BioelectricCell3", "BioelectricCell5", "BioelectricCell6", "BioelectricCell7", "BioelectricCell8",
            "Lockpick0", "Lockpick1", "Lockpick10", "Lockpick11", "Lockpick12", "Lockpick13", "Lockpick2",
            "Lockpick3", "Lockpick4", "MedKit2", "MedKit4", "MedKit5", "MedKit6", "MedKit7", "MedKit8", "Multitool0",
